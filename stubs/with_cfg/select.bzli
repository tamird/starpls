def _consume_string(r: str, pos: int) -> tuple[str, int]: ...

def consume_single_value(r: str, pos: int) -> tuple[str | bool | int | None | Label, int]: ...

def consume_list(r: str, pos: int) -> tuple[list[str | bool | int | None | Label], int]: ...

def _consume_list_or_single_value(r: str, pos: int) -> tuple[str | bool | int | None | Label | list[str | bool | int | None | Label], int]: ...

def _consume_compound_value(r: str, pos: int) -> tuple[str | bool | int | None | Label | list[str | bool | int | None | Label] | dict[str | bool | int | None | Label, str | bool | int | None | Label | list[str | bool | int | None | Label]], int]: ...

def _consume_condition_key(r: str, pos: int) -> tuple[str | Label, int]: ...

def _consume_outer_dict[K](
    r: str,
    pos: int,
    read_key: Callable[[str, int], tuple[K, int]],
) -> tuple[
    dict[
        K,
        str | bool | int | None | Label
        | list[str | bool | int | None | Label]
        | dict[
            str | bool | int | None | Label,
            str | bool | int | None | Label | list[str | bool | int | None | Label],
        ],
    ],
    int,
]: ...

def decompose_select_elements(value: object) -> list[
    tuple[
        Literal[True],
        dict[
            str | Label,
            str | bool | int | None | Label
            | list[str | bool | int | None | Label]
            | dict[
                str | bool | int | None | Label,
                str | bool | int | None | Label | list[str | bool | int | None | Label],
            ],
        ],
    ]
    | tuple[
        Literal[False],
        str | bool | int | None | Label
        | list[str | bool | int | None | Label]
        | dict[
            str | bool | int | None | Label,
            str | bool | int | None | Label | list[str | bool | int | None | Label],
        ]
        | dict[
            str | bool | int | None | Label,
            str | bool | int | None | Label
            | list[str | bool | int | None | Label]
            | dict[
                str | bool | int | None | Label,
                str | bool | int | None | Label | list[str | bool | int | None | Label],
            ],
        ],
    ]
]: ...

def _apply_func[K, V, R](
    func: Callable[[V], R],
    item: tuple[Literal[True], Mapping[K, V]] | tuple[Literal[False], V],
) -> tuple[Literal[True], dict[K, R]] | tuple[Literal[False], R]: ...
