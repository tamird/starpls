def is_bool(value: object) -> bool: ...

@overload
def is_dict[K, V](value: dict[K, V]) -> Literal[True]: ...

@overload
def is_dict(value: object) -> TypeIs[dict[Any, Any]]: ...

def is_int(value: object) -> bool: ...

def is_label(value: object) -> TypeGuard[Label]: ...

def is_list(value: object) -> TypeIs[list[Any]]: ...

def is_select(value: object) -> TypeIs[select[object, object]]: ...

def is_string(value: object) -> TypeGuard[str]: ...
