load(":types.bzli", _Builder = "Builder")

def _resettable(
    label: Label,
    *,
    self: _Builder,
    mutable_original_settings_label: list[Label],
    mutable_has_been_built: list[bool],
) -> _Builder: ...

def _reset_on_attrs(
    attrs: tuple[str, ...],
    *,
    self: _Builder,
    attrs_to_reset: list[str],
    mutable_has_been_built: list[bool],
) -> _Builder: ...
