load(":types.bzli", _Builder = "Builder")

def _resettable(
    label: Label,
    *,
    self: _Builder,
    mutable_original_settings_label: list[Label],
    mutable_has_been_built: list[bool],
) -> _Builder: ...

def _reset_on_attrs(
    attrs: tuple[str, ...],
    *,
    self: _Builder,
    attrs_to_reset: list[str],
    mutable_has_been_built: list[bool],
) -> _Builder: ...

@overload
def _clone_value_deeply[T](value: list[T]) -> list[T]: ...

@overload
def _clone_value_deeply[K, V](value: dict[K, V]) -> dict[K, V]: ...

@overload
def _clone_value_deeply[T: (str, Label, int, bool, None)](value: T) -> T: ...
