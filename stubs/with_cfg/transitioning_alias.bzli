class _AliasAttrs(Protocol):
    @property
    def exports(self) -> list[Target]: ...

def make_transitioning_alias(
    *,
    providers: Sequence[Provider[object] | Callable[..., object]],
    transition: transition,
    values: Mapping[str | Label, object],
    original_settings_label: Label | None,
) -> rule: ...

def _make_transitioning_alias_impl(
    *, providers: Sequence[Provider[object] | Callable[..., object]],
) -> Callable[[ctx[object, _AliasAttrs]], list[object]]: ...

def _transitioning_alias_base_impl(
    ctx: ctx[object, _AliasAttrs],
    *, providers: Sequence[Provider[object] | Callable[..., object]],
) -> list[object]: ...
