class _ResetTarget(Protocol):
    def __call__(self, *, name: str, exports: Label) -> None: ...

def _replace_single_dep(
    *,
    label_string: object,
    label_map: dict[Label, str],
    reset_target: _ResetTarget,
    name_prefix: str,
    mutable_num_calls: list[int],
) -> str | Label: ...

def _filter_frontend_exec_properties(value: object) -> dict[str, object]: ...
