class _JavaCommon(Protocol):
    @property
    def BootClassPathInfo(self) -> Provider[Any] | Callable[..., Any]: ...

    @property
    def JavaRuntimeInfo(self) -> Provider[Any] | Callable[..., Any]: ...

    @property
    def JavaToolchainInfo(self) -> Provider[Any] | Callable[..., Any]: ...

    @type_check_only
    def __getattr__(self, name: str) -> Any: ...


def _make_java_common() -> _JavaCommon: ...

def _get_message_bundle_info() -> None: ...

def _add_constraints(java_info: object, constraints: object = ...) -> object: ...

def _get_constraints(java_info: object) -> list[str]: ...

def _set_annotation_processing(
    java_info: object,
    enabled: object = ...,
    processor_classnames: object = ...,
    processor_classpath: object = ...,
    class_jar: object = ...,
    source_jar: object = ...,
) -> None: ...

def _java_toolchain_label(java_toolchain: object) -> None: ...
